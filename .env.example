# Variables para docker compose. Copia como .env y cambia los secretos.
COMPOSE_PROJECT_NAME=tutorias
WEB_PORT=8080

MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_DATABASE=tutorias
MYSQL_USER=tutorias
MYSQL_PASSWORD=cambia-esta-clave

# php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=cambia-este-secreto-por-64-caracteres-aleatorios-0123456789abcdef
APP_URL=http://localhost:8080
# Ponlo en true cuando sirvas por HTTPS
COOKIE_SECURE=false
