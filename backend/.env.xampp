# Configuración lista para XAMPP (MySQL/MariaDB con usuario root sin contraseña).
# instalar_y_ejecutar.bat la copia como .env si no existe.
APP_ENV=development
APP_URL=http://localhost:5173
APP_TIMEZONE=America/Bogota
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tutorias
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=desarrollo-local-xampp-uniminuto-arquitectura-2026-clave-segura
JWT_TTL_SECONDS=28800
COOKIE_SECURE=false
BCRYPT_COST=12
MAIL_DRIVER=log
CACHE_ENABLED=true
LOG_LEVEL=info
