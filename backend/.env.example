# ---------------------------------------------------------------
# Sistema de Tutorías UNIMINUTO — configuración (12-factor)
# Copia este archivo como .env para desarrollo local sin Docker.
# ---------------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:5173
APP_TIMEZONE=America/Bogota

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tutorias
# En XAMPP: DB_USERNAME=root y DB_PASSWORD vacío
DB_USERNAME=tutorias
DB_PASSWORD=tutorias_dev

# Genera uno propio: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-64-caracteres-minimo
JWT_TTL_SECONDS=28800
# En desarrollo sin HTTPS las cookies Secure no se guardan:
COOKIE_SECURE=false

BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Reglas de negocio
BOOKING_MIN_ADVANCE_MINUTES=60
BOOKING_MAX_DAYS_AHEAD=28
BOOKING_CANCELLATION_HOURS=3
BOOKING_MAX_ACTIVE_PER_STUDENT=5

# Correo: "log" (solo registra) o "smtp"
MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=tutorias@uniminuto.edu.co
MAIL_FROM_NAME="Tutorías UNIMINUTO"

CACHE_ENABLED=true
LOG_LEVEL=info
